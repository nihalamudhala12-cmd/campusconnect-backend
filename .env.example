# CampusConnect Backend Environment Configuration
# Step 6.1 - Foundation Setup
# Copy this file to .env and fill in the values

# Application
PORT=3000
NODE_ENV=development

# Application Security
# WARNING: Change this to a strong random secret before production deployment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=1d

# Database (Step 6.3 — Database Preparation)
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# This value is read by config/index.js. No credentials are stored in source.
DATABASE_URL=postgresql://campusconnect:change_me@localhost:5432/campusconnect

# Optional overrides (used only if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=campusconnect
# DB_USER=campusconnect
# DB_PASSWORD=change_me
# DB_SSL=false
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=10000

# Application URLs (Foundation - base URLs only)
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_HEALTH_CHECK=true
ENABLE_API_VERSIONING=true

# AI Configuration (Local response engine - no external LLM provider)
# The AI Assistant runs on a local rule-based engine and does not require
# any external LLM provider, API keys, or model configuration.